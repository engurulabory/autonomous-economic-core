<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.enguru.aec.field</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__AEC_REPO__/scripts/run_field_runtime.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__AEC_REPO__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__AEC_REPO__/runtime/logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__AEC_REPO__/runtime/logs/launchd.err.log</string>
</dict>
</plist>
